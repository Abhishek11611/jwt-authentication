<configuration>

    <!-- Log file location -->
    <property name="LOG_PATH" value="logs"/>
    <property name="APP_NAME" value="my-app"/>

    <!-- ================= CONSOLE APPENDER (colored + timestamp) ================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %highlight(%-5level) %logger{30} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ================= FILE APPENDER (plain, with timestamp) ================= -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %-5level %logger{30} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ================= SPRING & FRAMEWORK LOGS ================= -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework.security" level="ERROR"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>

    <!-- ================= APPLICATION LOGS ================= -->
    <logger name="c.e.d" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- ================= ROOT ================= -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
